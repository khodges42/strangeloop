{
  "name": "strangeloop",
  "displayName": "strangeloop",
  "description": "A muted VS Code theme suite inspired by recursive systems theory, printer-paper academia, and long nights staring into calm machines.",
  "version": "0.0.1",
  "publisher": "khodges42",
  "engines": {
    "vscode": "^1.73.0"
  },
  "categories": [
    "Themes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/khodges42/strangeloop"
  },
  "contributes": {
    "themes": [
      {
        "label": "strangeloop-dark",
        "uiTheme": "vs-dark",
        "path": "./themes/strangeloop-color-theme-dark.json"
      },
      {
        "label": "strangeloop-light",
        "uiTheme": "vs-light",
        "path": "./themes/strangeloop-color-theme-light.json"
      }
    ]
  }
}
