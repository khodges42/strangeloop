	"tokenColors": [
	  {
		"name": "Comment",
		"scope": [
		  "comment",
		  "punctuation.definition.comment"
		],
		"settings": {
		  "fontStyle": "italic",
		  "foreground": "#5D5852"
		}
	  },
	  {
		"name": "Variables",
		"scope": [
		  "variable",
		  "string constant.other.placeholder"
		],
		"settings": {
		  "foreground": "#D8D0C4"
		}
	  },
	  {
		"name": "Colors",
		"scope": [
		  "constant.other.color"
		],
		"settings": {
		  "foreground": "#D8D0C4"
		}
	  },
	  {
		"name": "Invalid",
		"scope": [
		  "invalid",
		  "invalid.illegal"
		],
		"settings": {
		  "foreground": "#FF4F5E"
		}
	  },
	  {
		"name": "Keyword, Storage",
		"scope": [
		  "keyword",
		  "storage.type",
		  "storage.modifier"
		],
		"settings": {
		  "foreground": "#9CB477"
		}
	  },
	  {
		"name": "Operator, Misc",
		"scope": [
		  "keyword.control",
		  "constant.other.color",
		  "punctuation",
		  "meta.tag",
		  "punctuation.definition.tag",
		  "punctuation.separator.inheritance.php",
		  "punctuation.definition.tag.html",
		  "punctuation.definition.tag.begin.html",
		  "punctuation.definition.tag.end.html",
		  "punctuation.section.embedded",
		  "keyword.other.template",
		  "keyword.other.substitution"
		],
		"settings": {
		  "foreground": "#B99A68"
		}
	  },
	  {
		"name": "Tag",
		"scope": [
		  "entity.name.tag",
		  "meta.tag.sgml",
		  "markup.deleted.git_gutter"
		],
		"settings": {
		  "foreground": "#B48A72"
		}
	  },
	  {
		"name": "Function, Special Method",
		"scope": [
		  "entity.name.function",
		  "meta.function-call",
		  "variable.function",
		  "support.function",
		  "keyword.other.special-method"
		],
		"settings": {
		  "foreground": "#8FA7C2"
		}
	  },
	  {
		"name": "Block Level Variables",
		"scope": [
		  "meta.block variable.other"
		],
		"settings": {
		  "foreground": "#C6BEB2"
		}
	  },
	  {
		"name": "Other Variable, String Link",
		"scope": [
		  "support.other.variable",
		  "string.other.link"
		],
		"settings": {
		  "foreground": "#C6BEB2"
		}
	  },
	  {
		"name": "Number, Constant, Function Argument, Tag Attribute, Embedded",
		"scope": [
		  "constant.numeric",
		  "constant.language",
		  "support.constant",
		  "constant.character",
		  "constant.escape",
		  "variable.parameter",
		  "keyword.other.unit",
		  "keyword.other"
		],
		"settings": {
		  "foreground": "#D0A466"
		}
	  },
	  {
		"name": "String, Symbols, Inherited Class, Markup Heading",
		"scope": [
		  "string",
		  "constant.other.symbol",
		  "constant.other.key",
		  "entity.other.inherited-class",
		  "markup.heading",
		  "markup.inserted.git_gutter",
